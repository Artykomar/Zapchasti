# Local SQLite development database is created at ./data/zemazap.sqlite.
# Production target for the real launch:
# DATABASE_URL=postgresql://user:password@host:5432/zemazap

# Temporary admin access. Change before production.
ZEMAZAP_ADMIN_PASSWORD=change-this-password
ZEMAZAP_ADMIN_SESSION_SECRET=change-this-random-secret

# Notification recipients/channels. Fill when ready to test real delivery.
ZEMAZAP_SITE_URL=http://127.0.0.1:3000
ZEMAZAP_MANAGER_EMAIL=
ZEMAZAP_SMTP_HOST=
ZEMAZAP_SMTP_PORT=465
ZEMAZAP_SMTP_SECURE=true
ZEMAZAP_SMTP_USER=
ZEMAZAP_SMTP_PASSWORD=
ZEMAZAP_SMTP_FROM=
ZEMAZAP_TELEGRAM_CHAT_ID=
ZEMAZAP_TELEGRAM_BOT_TOKEN=
