# Next.js frontend configuration.
# Django backend configuration lives in backend/.env.example.

# Frontend server-side routes proxy API requests to Django through this URL.
ZEMAZAP_DJANGO_API_URL=http://127.0.0.1:8000

# Public site contract. Keep these in sync with backend/.env.example before
# external domain, bank moderation, payment acquiring and fiscalization checks.
