DJANGO_SECRET_KEY=change-this-django-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Production hardening. With DJANGO_DEBUG=false, DJANGO_SECRET_KEY and
# DJANGO_ALLOWED_HOSTS are mandatory, Browsable API is disabled, and secure
# cookie/HSTS/SSL defaults are enabled unless explicitly overridden here.
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
DJANGO_CUSTOMER_REQUEST_THROTTLE=10/min
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=524288
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

# Local default is SQLite at backend/data/zemazap_django.sqlite3.
# Production target:
# DATABASE_URL=postgresql://user:password@host:5432/zemazap

ZEMAZAP_SITE_URL=http://127.0.0.1:3000
ZEMAZAP_INDEXING_ALLOWED=false
ZEMAZAP_BRAND_NAME=Zemazap
ZEMAZAP_TAGLINE=автозапчасти под заказ
ZEMAZAP_REGION=Регион работы уточняется
ZEMAZAP_ADDRESS=
ZEMAZAP_BUSINESS_HOURS=Пн-Сб, график будет задан
ZEMAZAP_PUBLIC_PHONE_LABEL=+7 (000) 000-00-00
ZEMAZAP_PUBLIC_PHONE_HREF=+70000000000
ZEMAZAP_PUBLIC_EMAIL=orders@example.ru
ZEMAZAP_MAX_URL=
ZEMAZAP_SELLER_PROFILE=unknown
ZEMAZAP_LEGAL_NAME=
ZEMAZAP_LEGAL_INN=
ZEMAZAP_LEGAL_OGRN=
ZEMAZAP_LEGAL_KPP=
ZEMAZAP_LEGAL_ADDRESS=
ZEMAZAP_ACTUAL_ADDRESS=
ZEMAZAP_CLAIMS_EMAIL=
ZEMAZAP_BANK_NAME=
ZEMAZAP_BANK_ACCOUNT=
ZEMAZAP_BANK_CORRESPONDENT_ACCOUNT=
ZEMAZAP_BANK_BIK=
ZEMAZAP_TAX_MODE=unknown
ZEMAZAP_VAT_LABEL=НДС не задан
ZEMAZAP_PRIVACY_POLICY_VERSION=draft-2026-08-15
ZEMAZAP_PRIVACY_CONSENT_VERSION=draft-2026-08-15
ZEMAZAP_TERMS_VERSION=draft-2026-08-15

PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=alfa
PAYMENTS_MODE=test
FISCALIZATION_ENABLED=false
MAX_ENABLED=false
PII_IN_NOTIFICATIONS_ALLOWED=false
ANALYTICS_ENABLED=false

ALFA_BANK_GATEWAY_URL=
ALFA_BANK_USERNAME=
ALFA_BANK_PASSWORD=

YANDEX_OBJECT_STORAGE_ENDPOINT=
YANDEX_OBJECT_STORAGE_BUCKET=
